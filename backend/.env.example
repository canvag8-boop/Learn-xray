# LearnX-Ray Production Configuration Template
# Copy this file to .env and replace placeholders with strong, secret values.

# Application Settings
APP_NAME=LearnX-Ray
APP_VERSION=1.0.0
DEBUG=False
ENVIRONMENT=production

# Security & Authentication (REQUIRED: Generate a 32+ character random secret)
SECRET_KEY=generate_a_secure_random_string_here_min_32_chars
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (PostgreSQL recommended for production, or persistent SQLite)
DATABASE_URL=sqlite:///./learnxray.db

# CORS Allowed Origins (Comma-separated production domains)
CORS_ORIGINS=https://your-domain.com,https://app.your-domain.com

# AI Provider Configuration (Optional: fallback engine runs 100% offline via SymPy)
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
